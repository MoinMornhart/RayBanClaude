// Kopieren nach ios/Secrets.xcconfig und eigene Werte eintragen (Datei ist in .gitignore).
// Nur nötig, wenn du in Xcode selbst signierst oder die App über Meta-Release-Channels verteilst.

// Deine Apple-Team-ID (Xcode → Settings → Accounts)
DEVELOPMENT_TEAM =

// Eigene Bundle-ID (ohne Bindestrich), falls com.raybanclaude.app schon vergeben ist
// RAYBANCLAUDE_BUNDLE_ID = com.deinname.raybanclaude

// Nur für Verteilung über Meta-Release-Channels (developers.meta.com → Wearables)
META_APP_ID = 0
META_CLIENT_TOKEN =
